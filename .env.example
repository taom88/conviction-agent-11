# Optional. Needed only for private-agent signed URLs, server-side conversation
# retrieval, and API-driven publishing. Public agents can run without it.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=agent_your_agent_id

# Public browser connection. Agent IDs are not secrets for public agents.
VITE_ELEVENLABS_AGENT_ID=agent_your_agent_id

# Optional for localhost-only use. Set a long random value before exposing the
# server beyond your own machine.
OWNER_TOKEN=

# Local-only defaults.
APP_HOST=127.0.0.1
APP_PORT=8787
DATABASE_PATH=.data/conviction.db
LOCAL_RETENTION_DAYS=7
JOB_STALE_AFTER_MINUTES=15
ELEVENLABS_API_BASE=https://api.elevenlabs.io

# Optional OpenAI-compatible evaluator. The API key is optional for a local
# endpoint such as http://127.0.0.1:11434/v1.
EVALUATOR_BASE_URL=
EVALUATOR_API_KEY=
EVALUATOR_MODEL=

# Optional and cost-bearing. Runs one motivating scenario plus two regression
# scenarios against the current and candidate prompts before approval.
EVALUATOR_RUN_CANDIDATE_TESTS=false
